{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "bun ../../scripts/build-server.mjs",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --fix",
    "check-types": "tsc --noEmit",
    "deploy:prod": "./.deploy/scripts/deploy.sh prod",
    "deploy:beta": "./.deploy/scripts/deploy.sh beta",
    "deploy:sandbox": "./.deploy/scripts/deploy.sh sandbox",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "sentry:verify": "tsx --env-file-if-exists=.env src/scripts/verify-sentry.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logs": "workspace:*",
    "@repo/storage": "workspace:*",
    "@sentry/hono": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "tsx": "^4.23.15"
  }
}
