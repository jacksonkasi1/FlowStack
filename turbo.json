{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".output/**",
        ".next/**",
        "!.next/cache/**",
        "!**/*.map"
      ],
      "env": ["VITE_*", "SENTRY_RELEASE", "SENTRY_ORG", "SENTRY_PROJECT"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "FLOWSTACK_*",
        "BETTER_AUTH_*",
        "FRONTEND_URL",
        "DATABASE_URL",
        "ALLOWED_ORIGINS",
        "DOMAIN",
        "LOG_*",
        "ZEPTOMAIL_*",
        "EMAIL_*",
        "GOOGLE_CLIENT_*",
        "R2_*",
        "SENTRY_*",
        "VITE_*"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.production",
    ".flowstack.json",
    "packages/config/src/config/preset.ts"
  ],
  "globalEnv": ["NODE_ENV", "PORT"]
}
