{
  "name": "flowstack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint --config eslint.config.mjs apps packages scripts tests",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "setup": "node scripts/setup.mjs",
    "test": "bun test tests",
    "check:all": "bun run check-types && bun run test && bun run build",
    "verify:presets": "node scripts/verify-presets.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "hono": "^4.13.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
